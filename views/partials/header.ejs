<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || "For Honor - Kulturmøter" %></title>

  <link rel="stylesheet" href="/css/style.css">
</head>
<%
  const pageClasses = bodyClass || "";
  const isAuthPage = pageClasses.indexOf("auth-page") !== -1 || pageClasses.indexOf("forbidden-page") !== -1;
  const isAdminPage = pageClasses.indexOf("admin-page") !== -1;
  const isSourcesPage = pageClasses.indexOf("sources-page") !== -1;
%>
<body class="<%= pageClasses %>">

<header>
  <a class="brand" href="/">
    <div class="logo">
      <h1>FOR HONOR</h1>
      <p>Kulturmøter mellom Samurai, Vikings og Knights</p>
    </div>
  </a>

  <nav class="main-nav">
    <% if (isAuthPage) { %>
      <a href="/">Til forsiden</a>
      <a href="/kilder">Kilder</a>
    <% } else if (isAdminPage) { %>
      <a href="/">Til forsiden</a>
      <a href="#admin-panel">Opplasting</a>
      <a href="/kilder">Kilder</a>
    <% } else if (isSourcesPage) { %>
      <a href="/">Til forsiden</a>
    <% } else { %>
      <a href="#featured-video">Video</a>
      <a href="#samurai">Samurai</a>
      <a href="#vikings">Vikings</a>
      <a href="#knights">Knights</a>
      <a href="/kilder">Kilder</a>
    <% } %>
  </nav>

  <div class="header-actions">
    <% if (isAuthPage) { %>
      <a class="nav-action nav-admin" href="/">Til forsiden</a>
    <% } else if (currentUser) { %>
      <span class="user-chip">
        <span><%= currentUser.username %></span>
        <small><%= currentUser.role %></small>
      </span>

      <% if (isAdmin) { %>
        <a class="nav-action nav-admin" href="/admin">Admin</a>
      <% } %>

      <form class="logout-form" action="/logout" method="POST">
        <button type="submit">Logg ut</button>
      </form>
    <% } else { %>
      <a class="nav-action" href="/login">Logg inn</a>
      <a class="nav-action nav-admin" href="/register">Lag bruker</a>
    <% } %>
  </div>
</header>
