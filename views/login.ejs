<%- include("partials/header", { pageTitle: pageTitle, bodyClass: bodyClass }) %>

<section class="auth-shell">
  <div class="auth-copy">
    <p class="section-kicker">Tilgang</p>
    <h2>Logg inn</h2>
    <p>
      Logg inn for å åpne adminpanelet. Vanlige brukere trenger bare en konto for å kunne logge inn senere.
    </p>

    <div class="auth-links">
      <a href="/register?redirect=<%= encodeURIComponent(redirectTo || '/') %>">Lag ny bruker</a>
      <a href="/">Til forsiden</a>
    </div>
  </div>

  <form class="auth-card" action="/login" method="POST">
    <h3>Innlogging</h3>

    <% if (message) { %>
      <p class="auth-message <%= message.type %>"><%= message.text %></p>
    <% } %>

    <input type="hidden" name="redirectTo" value="<%= redirectTo || '/' %>">

    <label>
      <span>E-post</span>
      <input type="email" name="email" value="<%= email || '' %>" autocomplete="email" required>
    </label>

    <label>
      <span>Passord</span>
      <input type="password" name="password" autocomplete="current-password" required>
    </label>

    <button type="submit">Logg inn</button>
  </form>
</section>

<%- include("partials/footer") %>
